# The virtualenv. 423M, and recreatable from quality/scripts requirements.
.venv/
__pycache__/
*.pyc

# Scanner working directories. Regenerated by scan-all.py on every run, 8.5M, and
# they contain a full second copy of every notebook's extracted code.
quality/scan/
quality/scans/

# Raw notebook dumps used while auditing. Regenerated on demand from the repo.
quality/dumps/
quality/dumps2/

# Run logs. Useful during a session, noise in history.
quality/logs/

# A presigned scanner report URL embeds temporary credentials in its query string, so
# no raw scan response is ever committed.
*reportUrl*
*presigned*
