# Copy to agent.env (gitignored) and fill in. Environment variables override this file.
AWS_REGION=us-east-1
# Verified SES identities: the first is the sender, all of them receive. Empty = no email.
SES_SENDERS=you@example.com
# Hosts the agent must never read, because it publishes to a public repository.
INTERNAL_HOST_SUFFIXES=corp.example.com,wiki.example.net
